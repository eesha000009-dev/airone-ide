# PlatformIO toolchain cache — downloaded by CI during build, not committed.
# The vendor/ directory is populated by GitHub Actions with the ESP32
# compiler toolchain and PlatformIO Core for offline compilation.
# electron-builder packages it from here into the installer.
# The .gitkeep is allowed so the directory structure is preserved.
vendor/platformio_cache/*
!vendor/platformio_cache/.gitkeep
!vendor/platformio_cache/lib/.gitkeep
vendor/platformio_packages/*
!vendor/platformio_packages/.gitkeep

# Android build outputs
applications/browser/android/app/build/
applications/browser/android/.gradle/
applications/browser/lib/

# Node.js binary and shared libraries for Android (downloaded by scripts/download-termux-nodejs.sh)
# These are ~90 MB and should NOT be committed to git
applications/browser/android/app/src/main/assets/nodejs/bin/node
applications/browser/android/app/src/main/assets/nodejs/lib/

# Keystore (should be stored as GitHub secret, not in repo)
# Uncomment the line below for production:
# applications/browser/android-signing/upload/
tool-results/

# Next.js build output
.next/
out/

# Build artifacts
webpack.config.js
